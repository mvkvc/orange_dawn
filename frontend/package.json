{
  "name": "orange-dawn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "check": "pnpm lint && pnpm audit --audit-level low && pnpm build && pnpm test",
    "format": "prettier --write .",
    "audit": "pnpm audit --audit-level low"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.3",
    "pixi.js": "8.7.3",
    "solid-js": "2.0.0-rc.3",
    "solid-pixi": "3.0.0-next.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@solidjs/diagnostics": "2.0.0-rc.3",
    "@solidjs/vite-plugin": "3.0.0-next.34",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "daisyui": "^5.8.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.7.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}

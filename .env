FRONTEND_PORT=5173
FRONTEND_API_ORIGIN=http://127.0.0.1:4000

BACKEND_PORT=4000
BACKEND_HOST=localhost
BACKEND_DATABASE_URL=ecto://postgres:postgres@localhost/orange_dawn_dev

# Production email settings (development uses /dev/mailbox).
FRONTEND_URL=
MAIL_FROM=

# Current production SMTP adapter.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Future Mailgun API adapter (not wired into runtime.exs yet).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_BASE_URL=

# Production Phoenix signing secret. Set the real value in Railway Variables.
BACKEND_SECRET_KEY_BASE=
